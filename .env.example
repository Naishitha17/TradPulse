# ==========================================================
# TRADEPULSE NEXUS ENVIRONMENT CONFIGURATION
# ==========================================================

# Database Configuration
# Supported drivers: SQLITE (default, zero-setup), POSTGRES
DB_TYPE=SQLITE
DB_PATH=tradepulse.db

# If using PostgreSQL:
# DB_TYPE=POSTGRES
# DB_URL=jdbc:postgresql://localhost:5432/tradepulse
# DB_USER=postgres
# DB_PASSWORD=your_password_here

# Financial News API (Optional)
# Get a free key at https://newsapi.org
# If not configured, TradePulse Nexus automatically falls back to realistic financial market news simulation
NEWS_API_KEY=your_news_api_key_here

# Market Simulation Configuration
INITIAL_VIRTUAL_BALANCE=100000.00
DEFAULT_CURRENCY=INR
MARKET_TICK_RATE_MS=2000

# Application Configuration
APP_ENV=development
APP_LOG_LEVEL=INFO
